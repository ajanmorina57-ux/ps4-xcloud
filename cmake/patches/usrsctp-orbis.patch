@@ -115,6 +115,33 @@ read_random(void *buf, size_t size)
 	return;
 }
 
+void
+finish_random(void)
+{
+	return;
+}
+#elif defined(__ORBIS__)
+#include <stdio.h>
+#include <stdlib.h>
+
+void
+init_random(void)
+{
+	return;
+}
+
+void
+read_random(void *buf, size_t size)
+{
+	FILE *source = fopen("/dev/urandom", "rb");
+	if (source == NULL || fread(buf, 1, size, source) != size) {
+		if (source != NULL)
+			fclose(source);
+		abort();
+	}
+	fclose(source);
+}
+
 void
 finish_random(void)
 {
